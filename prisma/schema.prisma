generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ScanRun {
  id                 String    @id @default(cuid())
  status             String    // "running" | "completed" | "failed"
  started_at         DateTime  @default(now())
  finished_at        DateTime?
  devices_count      Int       @default(0)
  error_message      String?
  // Прогресс по реальным этапам пайплайна — для индикатора загрузки в %.
  stage              String?   // "fetching_listings" | "analyzing" | "finalizing" | "saving"
  total_listings     Int?
  processed_listings Int       @default(0)
  issues_count       Int        @default(0)
  warnings_count     Int        @default(0)
  devices            Device[]
  scan_issues        ScanIssue[]

  @@index([status])
  @@index([started_at])
}

model ScanIssue {
  id         Int      @id @default(autoincrement())
  scan_id    String
  scan       ScanRun  @relation(fields: [scan_id], references: [id], onDelete: Cascade)
  listing_id Int?
  olx_url    String?
  title      String?
  severity   String   // "error" | "warning"
  kind       String
  message    String
  created_at DateTime @default(now())

  @@index([scan_id])
  @@index([severity])
  @@index([created_at])
}

model Device {
  id                   Int      @id            // OLX listing id, переиспользуется как PK
  title                String
  olx_url              String
  price_buy            Float?
  price_currency       String?
  is_negotiable        Boolean?
  brand                String
  model_query          String
  // Канонический ключ модели (для группировки цен и чекбокс-фильтра) и
  // человекочитаемая подпись — см. model-normalizer.ts. model_query остаётся
  // как есть (почти полный заголовок) для обратной совместимости и поиска.
  model_key            String                  @default("")
  model_label          String                  @default("")
  // Линейка модели (Galaxy S, iPhone Pro, Redmi Note…) — для сортировки/фильтра
  model_line           String                  @default("")
  model_line_label     String                  @default("")
  photos               String                  // JSON string[]
  city                 String?
  region               String?
  listing_created_at   DateTime
  release_year         Int?
  has_box              Boolean  @default(false)
  battery_health_percent Int?
  // Объём встроенной памяти (GB), извлечённый из заголовка/описания OLX
  storage_gb             Int?

  // Продавец (парсится со страницы объявления OLX)
  seller_name          String?
  seller_ads_count     Int?
  seller_member_since  String?

  damage_types         String                  // JSON string[]
  post_summary         String

  repairability_score  Float?
  repairability_scale  Float?
  ifixit_device_name   String?
  ifixit_url           String?

  allegro_search_url   String?
  parts_cost_estimate  Float?

  market_sell_price    Float?
  // "model_median" — медиана цен objявлений той же model_key без повреждений
  // в этом же скане; "brand_estimate" — fallback-эвристика по бренду, когда
  // сравнимых объявлений оказалось меньше MIN_COMPARABLE_LISTINGS_FOR_MEDIAN.
  market_sell_price_source String?
  profit_estimate      Float?
  profitability_pct    Float?

  confidence_score                 Int?
  confidence_label                 String?
  risk_adjusted_profit             Float?
  risk_adjusted_profitability_pct  Float?
  parts_real_count                 Int      @default(0)
  parts_estimate_count             Int      @default(0)

  liquidity_score      Float?
  liquidity_label      String?

  last_analyzed_at     DateTime
  scan_id              String
  scan                 ScanRun  @relation(fields: [scan_id], references: [id], onDelete: Cascade)
  parts                Part[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brand])
  @@index([profitability_pct])
  @@index([scan_id])
  @@index([model_key])
  @@index([model_line])
}

// Синглтон (единственная строка, id фиксирован = 1) — настройки приложения,
// применяются к следующему запуску pipeline (не влияют "на лету" на уже
// сохранённые результаты предыдущего скана).
model AppSettings {
  id                               Int      @id @default(1)
  battery_health_threshold_percent Int      @default(80)
  // Авто-актуализация: период (мин) для периодического авто-скана через
  // node-cron (см. scan-scheduler.ts). 0 = выключено (только автозапуск при
  // старте сервера, как раньше).
  auto_scan_interval_minutes       Int      @default(0)
  // TTL (часы) для БД-кеша ModelCache/PartsCostCache — см. model-cache.ts.
  // Диапазон 6ч-2160ч (~3 мес), задаётся слайдером в /settings.
  cache_ttl_hours                  Int      @default(72)
  // Логистика и ремонт (PLN, ориентиры PL 2026 — InPost/kurier).
  shipping_parts_pln               Float    @default(14)
  shipping_to_repair_pln           Float    @default(18)
  shipping_to_customer_pln         Float    @default(14)
  repair_labor_base_pln            Float    @default(80)
  // Тарифы подписки SmartFlip (PLN/мес), для отображения и расчётов.
  subscription_basic_pln           Float    @default(0)
  subscription_pro_pln             Float    @default(49)
  // Allegro HTML/API — только ручной запуск из админки (DataDome).
  allegro_parts_auto_enabled       Boolean  @default(false)
  // Авто-заполнение каталога моделей (iFixit + запчасти). 0 = выкл.
  catalog_auto_enrich_interval_minutes Int @default(0)
  // Пауза и повторы, если сайт запчастей отдал антибот (Allegro/Ceneo/OLX/магазины).
  catalog_antibot_wait_seconds     Int      @default(45)
  catalog_antibot_retries          Int      @default(2)
  catalog_source_delay_ms          Int      @default(400)
  updatedAt                        DateTime @updatedAt
}

model Part {
  id          Int     @id @default(autoincrement())
  title       String
  price       Float?
  currency    String?
  url         String
  image       String?
  damage_type String?
  is_estimate Boolean @default(false)
  source      String?

  device_id   Int
  device      Device  @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@index([device_id])
}

// L2-кеш (переживает рестарт процесса, в отличие от in-memory node-cache в
// cache.ts) свойств модели устройства, не зависящих от конкретного
// повреждения объявления: ремонтопригодность (iFixit) и кросс-скановый
// "якорь" рыночной цены — используется как промежуточный источник
// market_sell_price между медианой ТЕКУЩЕГО скана и грубым brand-fallback
// (см. brand-extractor.ts#estimateMarketSellPrice).
model ModelCache {
  id                   Int      @id @default(autoincrement())
  brand                String
  model_key            String
  repairability_score  Float?
  repairability_scale  Float?
  ifixit_device_name   String?
  ifixit_url           String?
  avg_market_price     Float?
  kimovil_geek_score       Float?
  kimovil_user_score       Float?
  kimovil_combined_score   Float?
  kimovil_matched_name     String?
  fetched_at           DateTime @default(now())
  expires_at           DateTime

  @@unique([brand, model_key])
  @@index([expires_at])
}

// Каталог моделей: агрегированные данные для ускорения анализа и ручная коррекция.
model DeviceCatalogEntry {
  id                           Int       @id @default(autoincrement())
  brand                        String
  model_key                    String
  model_label                  String    @default("")
  model_line                   String    @default("")
  model_line_label             String    @default("")
  model_query                  String    @default("")
  release_year                 Int?

  repairability_score          Float?
  repairability_scale          Float?
  ifixit_device_name           String?
  ifixit_url                   String?

  market_sell_price            Float?
  market_sell_price_source     String?

  manual_repairability_score   Float?
  manual_repairability_scale   Float?
  manual_market_sell_price     Float?
  manual_storage_prices        String?
  manual_repair_complexity_pct Float?
  lock_repairability           Boolean   @default(false)
  lock_market_price            Boolean   @default(false)
  notes                        String?

  enrichment_status            String    @default("pending")
  last_enriched_at             DateTime?
  last_enrichment_error        String?
  listings_seen_count          Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brand, model_key])
  @@index([enrichment_status])
  @@index([brand])
}

model CatalogEnrichmentRun {
  id               String    @id @default(cuid())
  status           String
  started_at       DateTime  @default(now())
  finished_at      DateTime?
  total_models     Int       @default(0)
  processed_models Int       @default(0)
  error_message    String?
  trigger          String    @default("manual")

  @@index([status])
  @@index([started_at])
}

/// Живой снимок заполнения каталога: общий для route-инстансов (next dev HMR).
model CatalogJobState {
  id            Int      @id
  progress_json String?
  updatedAt     DateTime @updatedAt
}

model PriceHistorySnapshot {
  id                   Int      @id @default(autoincrement())
  scan_id              String
  brand                String
  model_key            String
  storage_gb           Int?
  median_working_price Float
  sample_count         Int
  recorded_at          DateTime @default(now())

  @@index([brand, model_key])
  @@index([scan_id])
  @@index([recorded_at])
}

model ScanCoordinator {
  id               Int       @id @default(1)
  is_scan_active   Boolean   @default(false)
  active_scan_id   String?
  locked_until     DateTime?
  updatedAt        DateTime  @updatedAt
}

// L2-кеш стоимости запчастей — отдельно от ModelCache, т.к. набор запчастей
// зависит от конкретной комбинации повреждений (damage_signature), а не
// только от модели устройства.
model PartsCostCache {
  id                Int      @id @default(autoincrement())
  brand             String
  model_key         String
  damage_signature  String   @default("")
  parts_cost_estimate Float?
  allegro_search_url String?
  parts_json        String?
  fetched_at        DateTime @default(now())
  expires_at        DateTime

  @@unique([brand, model_key, damage_signature])
  @@index([expires_at])
}

// Персональные критерии "хорошей позиции" (1:1 с User). Списки брендов/
// моделей/регионов — JSON-массивы строк (пустой массив = "любой").
model UserNotificationSettings {
  id                    Int      @id @default(autoincrement())
  user_id               String   @unique
  user                  User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  enabled               Boolean  @default(false)
  brands                String   @default("[]")
  model_keys            String   @default("[]")
  min_profitability_pct Float?
  max_profitability_pct Float?
  min_price             Float?
  max_price             Float?
  regions               String   @default("[]")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// Денормализованный снимок объявления на момент уведомления — БЕЗ FK на
// Device (таблица Device перезаписывается на каждом скане). Привязка к User —
// у каждого пользователя своя лента и свои критерии.
model Notification {
  id                Int      @id @default(autoincrement())
  user_id           String
  user              User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  olx_listing_id    Int
  title             String
  olx_url           String
  price_buy         Float?
  profitability_pct Float?
  market_sell_price Float?
  city              String?
  region            String?
  photo_url         String?
  is_read           Boolean  @default(false)
  // "scan" — после скана по критериям; "test" — ручной тест из админки;
  // "scan_health" — сбой/деградация скана (лента могла остаться прежней).
  source            String   @default("scan")
  // "skipped" | "sent" | "failed" | "not_configured"
  telegram_status   String   @default("skipped")
  telegram_error    String?
  created_at        DateTime @default(now())

  @@index([user_id, is_read])
  @@index([created_at])
  @@index([source])
}

// Дедупликация per-user: одно и то же OLX-объявление не спамит одного
// пользователя повторно на следующих сканах; другой пользователь всё ещё
// может получить своё уведомление.
model NotifiedListing {
  id             Int      @id @default(autoincrement())
  user_id        String
  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  olx_listing_id Int
  notified_at    DateTime @default(now())

  @@unique([user_id, olx_listing_id])
  @@index([user_id])
}

// --- NextAuth + пользователи ---

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  role           String    @default("user") // "user" | "admin"
  is_approved    Boolean   @default(false)
  accounts       Account[]
  sessions       Session[]
  favorites            FavoriteDevice[]
  hidden_devices       HiddenDevice[]
  display_settings     UserDisplaySettings?
  notification_settings UserNotificationSettings?
  notifications        Notification[]
  notified_listings    NotifiedListing[]
  push_subscriptions   PushSubscription[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([is_approved])
  @@index([role])
}

// Web Push подписка браузера (endpoint уникален; у пользователя может быть
// несколько устройств/браузеров).
model PushSubscription {
  id         Int      @id @default(autoincrement())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  user_agent String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id])
}

// Персональные настройки отображения ленты (1:1 с User).
model UserDisplaySettings {
  id                    Int      @id @default(autoincrement())
  user_id               String   @unique
  user                  User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  exclude_junk_listings Boolean  @default(true)
  junk_min_release_year Int      @default(2017)
  exclude_iphone        Boolean  @default(false)
  exclude_android       Boolean  @default(false)
  battery_health_threshold_percent Int @default(80)
  // Скрывать объявления, у которых прибыль ниже порога в zł и/или % от цены покупки.
  exclude_unprofitable          Boolean @default(false)
  min_profit_pln                Float   @default(0)
  min_profit_pct_of_price       Float   @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model FavoriteDevice {
  id         Int      @id @default(autoincrement())
  user_id    String
  device_id  Int
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, device_id])
  @@index([user_id])
}

model HiddenDevice {
  id         Int      @id @default(autoincrement())
  user_id    String
  device_id  Int
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, device_id])
  @@index([user_id])
}
