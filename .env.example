# Database (Prisma / PostgreSQL)
# Локально: создайте БД `createdb olx_parser` или через Docker:
#   docker run --name olx-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=olx_parser -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/olx_parser?schema=public"

# HTTP
PORT=8080
APP_BIND_HOST=127.0.0.1

# Cache TTL (секунды)
IFIXIT_CACHE_TTL_SEC=86400
PARTS_CACHE_TTL_SEC=3600

# Опционально: Allegro REST API (если приложение верифицировано)
# ALLEGRO_CLIENT_ID=
# ALLEGRO_CLIENT_SECRET=
# Опционально: Scrapfly для обхода DataDome на Allegro (если HTML/API недоступны)
# SCRAPFLY_API_KEY=

# Pipeline settings
OLX_MAX_PAGES=5
OLX_PAGE_LIMIT=40
# Состояния объявлений для поиска, через запятую: damaged, used, new
OLX_STATE_FILTERS=damaged,used
# Защита от OLX HTTP 403 при частых сканах
SCAN_MIN_INTERVAL_SEC=120
OLX_LISTINGS_CONCURRENCY=1
OLX_LISTINGS_MIN_INTERVAL_MS=900
OLX_LISTINGS_PAGE_DELAY_MS=500
OLX_LISTINGS_STATE_DELAY_MS=1200
OLX_LISTINGS_RETRY_COUNT=3
# Опционально: cookie сессии olx.pl (если GraphQL отдаёт 403 без авторизации)
# OLX_COOKIE=
PARTS_PER_MODEL=4
PIPELINE_CONCURRENCY=8
# Таймаут анализа одного объявления (OLX + iFixit + запчасти), мс; по умолчанию 90000
LISTING_ANALYZE_TIMEOUT_MS=90000
# 1 = не дергать Ceneo в авто-скане (рекомендуется)
SKIP_CENEO=1
# Watchdog: running ScanRun старше N минут → failed
SCAN_STALE_TIMEOUT_MINUTES=90
# Delta-scan: 0 = всегда полный анализ всех объявлений
DELTA_SCAN=1
# Two-phase: полный анализ только топ-N кандидатов
TWO_PHASE=1
TWO_PHASE_FULL_ANALYZE_LIMIT=80
TWO_PHASE_MIN_PROFIT_PLN=80

# Уровень логов сервера: info (по умолчанию) | debug
LOG_LEVEL=info

# 1. Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web application)
# 2. Authorized JavaScript origins: https://your-domain.example
# 3. Authorized redirect URIs: https://your-domain.example/api/auth/callback/google
# Локально: http://localhost:8080 и http://localhost:8080/api/auth/callback/google
NEXTAUTH_URL=https://your-domain.example
AUTH_TRUST_HOST=true
AUTH_SECRET=generate-with-openssl-rand-base64-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAIL=

# Web Push (VAPID). Сгенерировать: npx web-push generate-vapid-keys
# Без ключей работает только in-app тост (polling); OS push не отправляется.
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com

# НЕ задавайте в production:
# E2E_SKIP_AUTH=true
