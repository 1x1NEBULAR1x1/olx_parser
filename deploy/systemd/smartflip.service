[Unit]
Description=SmartFlip OLX Parser (Next.js)
Documentation=https://github.com/your-org/olx_parser
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/smartflip
Environment=NODE_ENV=production
EnvironmentFile=/var/www/smartflip/.env
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=smartflip

# Безопасность
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/smartflip/prisma /var/lib/smartflip

[Install]
WantedBy=multi-user.target
